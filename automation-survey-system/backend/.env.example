# Flask 설정
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production

# PostgreSQL
POSTGRES_DB=tass_dev
POSTGRES_USER=tass_user
POSTGRES_PASSWORD=your-db-password-here
POSTGRES_PORT=5432

# Flask DB 연결 URL (docker-compose 사용 시)
DATABASE_URL=postgresql://tass_user:your-db-password-here@localhost:5432/tass_dev

# LDAP (leemock.local AD)
LDAP_SERVER=ldap://dc.leemock.local
LDAP_BASE_DN=DC=leemock,DC=local
LDAP_USER_SEARCH_BASE=OU=Users,DC=leemock,DC=local

# 파일 업로드
UPLOAD_FOLDER=uploads
